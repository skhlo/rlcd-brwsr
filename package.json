{
  "name": "rlcd-brwsr",
  "version": "0.1.0",
  "private": true,
  "description": "A bounded Jev Ultrafast browser tool for Pi",
  "scripts": {
    "bridge:check": ".venv/bin/python -m compileall -q bridge test/python",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm bridge:check",
    "format": "prettier --write .",
    "fixture": "node fixtures/click-only/serve.mjs",
    "format:check": "prettier --check .",
    "runtime:preflight": "scripts/preflight-runtime.sh",
    "runtime:setup": "scripts/setup-runtime.sh",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.8.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "24.13.6",
    "prettier": "3.9.8",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  }
}
